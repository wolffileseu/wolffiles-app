<?php

namespace App\Http\Controllers\Frontend;

use App\Http\Controllers\Controller;
use App\Models\Page;
use App\Services\SeoService;
use Illuminate\Support\Str;

class PageController extends Controller
{
    public function show($slug)
    {
        $page = Page::where("slug", $slug)->firstOrFail();
        abort_unless($page->is_published, 404);

        // Locale-aware accessors (Page-Model regelt Fallback auf DE intern)
        $title       = $page->translated_title;
        $content     = $page->translated_content;
        $contentType = $page->content_type ?? "richtext";

        // Markdown → HTML mit Heading-IDs für Anchor-Links
        $looksLikeMarkdown = $content && (
            str_starts_with(trim($content), "#")
            || str_contains($content, "##")
            || str_contains($content, "**")
        );

        if ($contentType === "markdown" || $looksLikeMarkdown) {
            $content = Str::markdown($content ?? "");

            $content = preg_replace_callback(
                "/<(h[1-6])>(.*?)<\/\\1>/i",
                function ($matches) {
                    $tag  = $matches[1];
                    $text = strip_tags($matches[2]);
                    $id   = Str::slug($text);
                    return "<{$tag} id=\"{$id}\">{$matches[2]}</{$tag}>";
                },
                $content
            );

            $page->_rendered = true;
        }

        $seo          = SeoService::defaults();
        $seo["title"] = $title;

        return view("frontend.pages.show", compact("page", "title", "content", "seo"));
    }
}
