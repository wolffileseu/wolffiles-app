global Map =
{
	Debug = 0, // please set to zero before distributing your script

	wood_fence_Destroyed = function( trigger )
	{
		SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_wood_fence" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_truck_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_truck_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "FLAG_actionfigure" );
		Util.MapDebugPrint( "wood_fence_Destroyed" );
	},

	actionfigure_Taken = function( trigger )
	{
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_flag_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_truck_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "PLANTMINE_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "PLANTMINE_truck_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_truck_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "CAPPOINT_truck" );
		Util.MapDebugPrint( "actionfigure_Taken" );
	},

	actionfigure_2_Taken = function( trigger )
	{
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_flag_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_truck_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "PLANTMINE_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "PLANTMINE_truck_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_truck_.*" );
		Util.MapDebugPrint( "actionfigure_2_Taken" );
	},

	actionfigure_Returned = function( trigger )
	{
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_flag_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_truck_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "PLANTMINE_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "PLANTMINE_truck_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_truck_.*" );
		Util.MapDebugPrint( "actionfigure_Returned" );
	},

	actionfigure_2_Returned = function( trigger )
	{
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_flag_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_truck_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "PLANTMINE_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "PLANTMINE_truck_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_truck_.*" );
		Util.MapDebugPrint( "actionfigure_2_Returned" );
	},

	actionfigure_Secured = function( trigger )
	{
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_flag_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_truck_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "PLANTMINE_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "PLANTMINE_truck_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_truck_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "FLAG_actionfigure_2" );
		Util.MapDebugPrint( "actionfigure_Secured" );
	},

	actionfigure_2_Secured = function( trigger )
	{
		Util.MapDebugPrint( "actionfigure_2_Secured" );
	},

};

global OnMapLoad = function()
{
	// Register callback functions
	OnTrigger( "Allies have destroyed the wood fence!", Map.wood_fence_Destroyed );
	OnTrigger( "The allies have stolen the first Actionfigure!", Map.actionfigure_Taken );
	OnTrigger( "The allies have stolen the second Actionfigure!", Map.actionfigure_2_Taken );
	OnTrigger( "The axis return the Actionfigure!", Map.actionfigure_Returned );
	OnTrigger( "The axis return the Actionfigure!", Map.actionfigure_2_Returned );
	OnTrigger( "The allies have secured the first Actionfigure!", Map.actionfigure_Secured );
	OnTrigger( "The allies have secured the second Actionfigure!", Map.actionfigure_2_Secured );

	Util.DisableGoal( ".*", true ); // all but routes
	//~SetAvailableMapGoals( TEAM.AXIS, true, "ATTACK_.*" );
	//~SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_.*" );
	SetAvailableMapGoals( TEAM.AXIS, true, "PLANTMINE_.*" );
	SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_flag_.*" );
	SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_truck_.*" );
    SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_flag_.*" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_truck_.*" );
	SetAvailableMapGoals( TEAM.AXIS, true, "PLANTMINE_.*" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_wood_fence" );
	SetAvailableMapGoals( TEAM.AXIS, true, "SMOKEBOMB_.*" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "SMOKEBOMB_.*" );
		
	// Max users per goal
	SetGoalPriority( "PLANT_wood_fence", 1.5, 0, CLASS.ENGINEER );
	SetGoalPriority( "PLANT_.*", 0.6, 0, CLASS.ENGINEER );
	Util.SetMaxUsers( 2, "PLANT.*" );
	//Util.SetMaxUsers( 1, "MOUNTMG42_.*" );

	// Camp times
	//SetMapGoalProperties( "MOUNTMG42_.*", {MinCampTime=15, MaxCampTime=90} );

	Util.MapDebugPrint( "Omni-bot map script by Pinn for " + GetMapName() + " executed." );
};

