global Map =
{
	Debug = 1, // please set to zero before distributing your script
	ShowMovers = false,

	Charge_Booster_Dyno = 0,
	Rope_Bridge_Dyno = 0,

	Charge_Booster_Built = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Util.MapDebugPrint( "Charge_Booster_Built" );
	},

	Rope_Bridge_Built = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Util.MapDebugPrint( "Rope_Bridge_Built" );
	},

	Charge_Booster_Planted = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Map.Charge_Booster_Dyno += 1;
		Util.MapDebugPrint( "Charge_Booster_Planted" );
	},

	Rope_Bridge_Planted = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Map.Rope_Bridge_Dyno += 1;
		Util.MapDebugPrint( "Rope_Bridge_Planted" );
	},

	Charge_Booster_Defused = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Map.Charge_Booster_Dyno -= 1;
		Util.MapDebugPrint( "Charge_Booster_Defused" );
	},

	Rope_Bridge_Defused = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Map.Rope_Bridge_Dyno -= 1;
		Util.MapDebugPrint( "Rope_Bridge_Defused" );
	},

	Charge_Booster_Destroyed = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Map.Charge_Booster_Dyno = 0;

		Util.MapDebugPrint( "Charge_Booster_Destroyed" );
	},

	Rope_Bridge_Destroyed = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Map.Rope_Bridge_Dyno = 0;

		Util.MapDebugPrint( "Rope_Bridge_Destroyed" );
	},

	axis_gold_crate_Taken = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Util.MapDebugPrint( "axis_gold_crate_Taken" );
	},

	axis_gold_crate_Returned = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Util.MapDebugPrint( "axis_gold_crate_Returned" );
	},

	axis_gold_crate_Secured = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Util.MapDebugPrint( "axis_gold_crate_Secured" );
	},

};

global OnMapLoad = function()
{
	if ( TestMapOn )
		{ Util.AutoTestMap(); }

	// Register callback functions
	OnTrigger( "MISSING_STRING", Map.Charge_Booster_Built );
	OnTrigger( "MISSING_STRING", Map.Rope_Bridge_Built );
	OnTrigger( "Planted at the MISSING_STRING.", Map.Charge_Booster_Planted );
	OnTrigger( "Planted at the MISSING_STRING.", Map.Rope_Bridge_Planted );
	OnTrigger( "Defused at the MISSING_STRING.", Map.Charge_Booster_Defused );
	OnTrigger( "Defused at the MISSING_STRING.", Map.Rope_Bridge_Defused );
	OnTrigger( "MISSING_STRING", Map.Charge_Booster_Destroyed );
	OnTrigger( "MISSING_STRING", Map.Rope_Bridge_Destroyed );
	OnTrigger( "MISSING_STRING", Map.axis_gold_crate_Taken );
	OnTrigger( "MISSING_STRING", Map.axis_gold_crate_Returned );
	OnTrigger( "MISSING_STRING", Map.axis_gold_crate_Secured );

	//~Util.DisableGoal( ".*", true ); // all but routes
	//~SetAvailableMapGoals( TEAM.AXIS, true, "ATTACK_.*" );
	//~SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_.*" );

	// Max users per goal
	Util.SetMaxUsers( 1, "ATTACK_.*" );
	Util.SetMaxUsers( 1, "DEFEND_.*" );
	Util.SetMaxUsers( 1, "GRENADE_.*" );
	Util.SetMaxUsers( 1, "SNIPE_.*" );
	Util.SetMaxUsers( 1, "MOUNTMG42_.*" );
	Util.SetMaxUsers( 1, "MOBILEMG42_.*" );
	Util.SetMaxUsers( 1, "MOBILEMORTAR_.*" );
	Util.SetMaxUsers( 1, "AIRSTRIKE_.*" );
	Util.SetMaxUsers( 1, "CALLARTILLERY_.*" );

	// Camp times
	SetMapGoalProperties( "MOUNTMG42_.*", {MinCampTime=15, MaxCampTime=90} );
	SetMapGoalProperties( "MOBILEMG42_.*", {MinCampTime=10, MaxCampTime=60} );


	Util.MapDebugPrint( "Omni-bot map script for " + GetMapName() + " executed." );
};

global OnBotJoin = function( bot )
{
	// Uncomment for shootable breakables
	//~bot.TargetBreakableDist = 90.0;
	// Only set MaxViewDistance on maps with limited sight (e.g. fog)
	//~bot.MaxViewDistance = 2400;
};

global InitializeRoutes = function()
{
	MapRoutes =
	{
		BUILD_Rope_Bridge =
		{
		},
		PLANT_Rope_Bridge =
		{
		},
		FLAG_axis_gold_crate =
		{
		},
		BUILD_Charge_Booster =
		{
		},
		PLANT_Charge_Booster =
		{
		},
	};
	Util.Routes(MapRoutes);
};
