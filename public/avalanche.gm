global Map =
{
	Debug = 1, // please set to zero before distributing your script

	wooden_barrier_Built = function()
	{
		SetAvailableMapGoals(TEAM.ALLIES, false, "FLAG_allied_obj2");
		Util.MapDebugPrint("wooden_barrier_Built");
	},

	corridor_gate_Destroyed = function()
	{
		SetAvailableMapGoals(TEAM.AXIS, false, "DEFEND_gate");
		SetAvailableMapGoals(TEAM.AXIS, true, "ROUTE_corridor");
		SetAvailableMapGoals(TEAM.AXIS, true, "DEFEND_barrier");
		SetAvailableMapGoals(TEAM.ALLIES, true, "DEFEND_barrier2");
		SetGoalPriority("MOBILEMG42_barrier", 1.0, TEAM.AXIS, CLASS.SOLDIER);
		SetGoalPriority("PLANT_wooden_barrier", 1.0, TEAM.ALLIES, CLASS.ENGINEER);
		SetGoalPriority("PLANT_wooden_barrier", 1.0, TEAM.ALLIES, CLASS.COVERTOPS);
		
		Wp.SetWaypointFlag("gateway", "closed", false);
		Util.MapDebugPrint("corridor_gate_Destroyed");
	},

	wooden_barrier_Destroyed = function()
	{
		SetAvailableMapGoals(TEAM.ALLIES, true, "FLAG_allied_obj2");
		Wp.SetWaypointFlag("barrier", "closed", false);
		Util.MapDebugPrint("wooden_barrier_Destroyed");
	},

	allied_obj2_Taken = function()
	{
		SetGoalPriority("DEFEND_truck", 1.0, TEAM.AXIS);
		SetGoalPriority("DEFEND_truck", 1.0, TEAM.AXIS);
		SetAvailableMapGoals(TEAM.AXIS, true, "DEFEND_truck");
		SetAvailableMapGoals(TEAM.AXIS, true, "DEFEND_truck2");
		SetAvailableMapGoals(TEAM.ALLIES, false, "DEFEND_barrier2");
		SetAvailableMapGoals(TEAM.AXIS, false, "DEFEND_barrier");
		Util.MapDebugPrint("allied_obj2_Taken");
	},

	allied_obj2_Returned = function()
	{
		Util.MapDebugPrint("allied_obj2_Returned");
	},

	allied_obj2_Secured = function()
	{
		Util.MapDebugPrint("allied_obj2_Secured");
	},

	forward_flag_Axis_Captured = function()
	{
		Util.MapDebugPrint("forward_flag_Axis_Captured");
	},

	forward_flag_Allies_Captured = function()
	{
		Util.MapDebugPrint("forward_flag_Allies_Captured");
	},

};

global OnMapLoad = function()
{
	OnTrigger("the wooden barrier has been contructed", Map.wooden_barrier_Built);
	OnTrigger("The Allies have destroyed the corridor gate!", Map.corridor_gate_Destroyed);
	OnTrigger("the wooden barrier has been destroyed", Map.wooden_barrier_Destroyed);
	OnTrigger("Allies have stolen the war Documents!", Map.allied_obj2_Taken);
	OnTrigger("MISSING_STRING", Map.allied_obj2_Returned);
	OnTrigger("MISSING_STRING", Map.allied_obj2_Secured);
	OnTrigger("MISSING_STRING", Map.forward_flag_Axis_Captured);
	OnTrigger("Allies have captured the Flag!", Map.forward_flag_Allies_Captured);

	SetAvailableMapGoals(TEAM.ALLIES, false, "DEFEND_truck");
	SetAvailableMapGoals(TEAM.AXIS, false, "DEFEND_truck");
	SetAvailableMapGoals(TEAM.ALLIES, false, "DEFEND_truck2");
	SetAvailableMapGoals(TEAM.AXIS, false, "DEFEND_truck2");
	SetAvailableMapGoals(TEAM.ALLIES, false, "DEFEND_gate");
	SetAvailableMapGoals(TEAM.AXIS, true, "DEFEND_gate");
	Util.SetMaxUsers(5, "DEFEND_gate");
    SetAvailableMapGoals(TEAM.AXIS, false, "ROUTE_corridor");
	SetAvailableMapGoals(TEAM.ALLIES, false, "MOBILEMG42_barrier");
	SetAvailableMapGoals(TEAM.AXIS, true, "MOBILEMG42_barrier");
	SetAvailableMapGoals(TEAM.AXIS, false, "DEFEND_barrier");
	SetAvailableMapGoals(TEAM.ALLIES, false, "DEFEND_barrier");
	Util.SetMaxUsers(5, "DEFEND_barrier");
	SetAvailableMapGoals(TEAM.AXIS, false, "PLANT_wooden_barrier");
	SetAvailableMapGoals(TEAM.ALLIES, true, "PLANT_wooden_barrier");
	SetAvailableMapGoals(TEAM.AXIS, false, "DEFEND_barrier2");
	SetAvailableMapGoals(TEAM.ALLIES, false, "DEFEND_barrier2");
	Util.SetMaxUsers(5, "DEFEND_barrier2");

	//~Util.DisableGoal(".*", true);
	//~SetAvailableMapGoals(TEAM.AXIS, true, "ATTACK_.*");
	//~SetAvailableMapGoals(TEAM.ALLIES, true, "ATTACK_.*");

	//Util.SetMaxUsers(1, "MOUNTMG42_.*");

	//SetMapGoalProperties("MOUNTMG42_.*", {MinCampTime=15, MaxCampTime=90});


	Util.MapDebugPrint("Omni-bot map script for " + GetMapName() + " executed.");
};

