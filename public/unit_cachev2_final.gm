global OnMapLoad = function()
{
	if ( TestMapOn )
		{ Util.AutoTestMap(); }

	// Register callback functions
	OnTrigger( "MISSING_STRING", Map.Backyard_Barrier_Built );
	OnTrigger( "MISSING_STRING", Map.House_MG42_Built );
	OnTrigger( "Command Post constructed", Map.Neutral_Command_Post_Built );
	OnTrigger( "MISSING_STRING", Map.Storage_Barrier_Built );
	OnTrigger( "Planted at the MISSING_STRING.", Map.Backyard_Barrier_Planted );
	OnTrigger( "Planted at the MISSING_STRING.", Map.Generator_Planted );
	OnTrigger( "Planted at the MISSING_STRING.", Map.House_MG42_Planted );
	OnTrigger( "Planted at the MISSING_STRING.", Map.Neutral_Command_Post_Planted );
	OnTrigger( "Planted at the Safe.", Map.Safe_Planted );
	OnTrigger( "Planted at the Long way gate.", Map.Long_way_gate_Planted );	
	OnTrigger( "Planted at the MISSING_STRING.", Map.Storage_Barrier_Planted );
	OnTrigger( "Defused at the MISSING_STRING.", Map.Backyard_Barrier_Defused );
	OnTrigger( "Defused at the MISSING_STRING.", Map.Generator_Defused );
	OnTrigger( "Defused at the MISSING_STRING.", Map.House_MG42_Defused );
	OnTrigger( "Defused at the MISSING_STRING.", Map.Neutral_Command_Post_Defused );
	OnTrigger( "Defused at the Safe.", Map.Safe_Defused );
	OnTrigger( "Defused at the MISSING_STRING.", Map.Storage_Barrier_Defused );
	OnTrigger( "MISSING_STRING", Map.Backyard_Barrier_Destroyed );
	OnTrigger( "MISSING_STRING", Map.Generator_Destroyed );
	OnTrigger( "MISSING_STRING", Map.House_MG42_Destroyed );
	OnTrigger( "MISSING_STRING", Map.Neutral_Command_Post_Destroyed );
	OnTrigger( "Allies have blown the Tresor", Map.Safe_Destroyed );
	OnTrigger( "MISSING_STRING", Map.Storage_Barrier_Destroyed );
	OnTrigger( "Allies have stolen the Keycard!", Map.Keycard_Taken );
	OnTrigger( "Axis have returned the Keycard!", Map.Keycard_Returned );
	OnTrigger( "Allies have open the gates!", Map.Keycard_Secured );
	OnTrigger( "Axis captured the Bunker!", Map.westbunker_flag_Axis_Captured );
	OnTrigger( "Allies captured the Bunker!", Map.westbunker_flag_Allies_Captured );
	
	Util.EnableGoal("CHECKPOINT_.*");
	Util.DisableGoal("FLAG_.*");
	Util.DisableGoal("BUILD_Neutral_Command_Post");
	Util.DisableGoal("PLANTMINE_.*");
	Util.DisableGoal("BUILD_House_MG42");
	Util.DisableGoal("BUILD_Storage_Barrier");
	Util.DisableGoal("BUILD_Backyard_Barrier");
	
    ETUtil.SetPrimaryGoals(1.0);
	ETUtil.LimitToClass( "PLANT_Safe", TEAM.ALLIES, CLASS.ENGINEER);
	ETUtil.LimitToClass( "CHECKPOINT_.*", TEAM.ALLIES, CLASS.MEDIC);
	ETUtil.LimitToClass( "CHECKPOINT_.*", TEAM.AXIS, CLASS.MEDIC);		

	//~Util.DisableGoal( ".*", true ); // all but routes
	SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_.*" );
	SetAvailableMapGoals( TEAM.AXIS, true, "CALLARTILLERY_axis_arti_.*" );
	SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_Neutral_Command_Post" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_allies_attack_safe_.*" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_.*" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_allies_attack_generator_.*" );
	
	SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_axis_defend_keycardcapture_.*" );
	SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_axis_defend_longway_.*" );
	SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_axis_defend_generator_.*" );
	SetAvailableMapGoals( TEAM.AXIS, false, "AIRSTRIKE_axis_airstrike_backyard" );
	
	SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_.*" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Neutral_Command_Post" );
	
	SetGoalPriority( "PLANT_Safe", 0.9);
	SetGoalPriority( "PLANT_Long_way_gate", 0.6);

	// Max users per goal
	Util.SetMaxUsers( 1, "ATTACK_.*" );
	Util.SetMaxUsers( 1, "DEFEND_.*" );
	Util.SetMaxUsers( 1, "GRENADE_.*" );
	Util.SetMaxUsers( 1, "SNIPE_.*" );
	Util.SetMaxUsers( 1, "MOUNTMG42_.*" );
	Util.SetMaxUsers( 1, "MOBILEMG42_.*" );
	Util.SetMaxUsers( 1, "MOBILEMORTAR_.*" );
	Util.SetMaxUsers( 1, "AIRSTRIKE_.*" );
	Util.SetMaxUsers( 1, "CALLARTILLERY_.*" );

	// Camp times
	SetMapGoalProperties( "MOUNTMG42_.*", {MinCampTime=15, MaxCampTime=90} );
	SetMapGoalProperties( "MOBILEMG42_.*", {MinCampTime=10, MaxCampTime=60} );


};

