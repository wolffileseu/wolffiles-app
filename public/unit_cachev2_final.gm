global Map =
{
	Debug = 0, // please set to zero before distributing your script
	ShowMovers = false,

	Backyard_Barrier_Dyno = 0,
	Generator_Dyno = 0,
	House_MG42_Dyno = 0,
	Neutral_Command_Post_Dyno = 0,
	Safe_Dyno = 0,
	Storage_Barrier_Dyno = 0,
	Long_way_gate_Dyno = 0,
	
	DocStatus = 0,
	
	ForwardFlag = "CHECKPOINT_westbunker_flag",
	Build_CP	= "BUILD_Neutral_Command_Post",
	Plant_CP	= "PLANT_Neutral_Command_Post",
	Build_storageb	= "BUILD_Storage_Barrier",
	Plant_storageb	= "PLANT_Storage_Barrier",
	Build_backyardb	= "BUILD_Backyard_Barrier",
	Plant_backyardb	= "PLANT_Backyard_Barrier",
	Build_housemg	= "BUILD_House_MG42",
		

	Safe_Planted = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Map.Safe_Dyno += 1;
		Util.MapDebugPrint( "Safe_Planted" );
		
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_allies_attack_safe_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_axis_defend_safe_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_axis_defend_flag_.*" );	
	},
	
	Safe_Defused = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Map.Safe_Dyno -= 1;
		Util.MapDebugPrint( "Safe_Defused" );
	},

	Safe_Destroyed = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Map.Safe_Dyno = 0;

		Util.MapDebugPrint( "Safe_Destroyed" );
		
		Util.EnableGoal("FLAG_.*");
		
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_axis_defend_keycardcapture_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_axis_defend_flag_.*" );
	},
	
	westbunker_flag_Axis_Captured = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Util.MapDebugPrint( "westbunker_flag_Axis_Captured" );
	},

	westbunker_flag_Allies_Captured = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Util.MapDebugPrint( "westbunker_flag_Allies_Captured" );
	},	
	
	Keycard_Taken = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Util.MapDebugPrint( "Keycard_Taken" );
		
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_axis_defend_keycardcapture_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_axis_defend_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_axis_defend_safe_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "CHECKPOINT_.*" );
	},

	Keycard_Returned = function( trigger )
	{
		if ( TestMap )
			{ return; }

		Util.MapDebugPrint( "Keycard_Returned" );
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_axis_defend_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_axis_defend_safe_.*" );		
	},

	Keycard_Secured = function( trigger )
	{
		if ( TestMap )
			{ return; }

		SetAvailableMapGoals( TEAM.ALLIES, false, "CHECKPOINT_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "DEFEND_axis_defend_keycardcapture_.*" );SetAvailableMapGoals( TEAM.ALLIES, false, "DEFEND_axis_defend_flag_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_allies_attack_safe_.*" );
		
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_allies_attack_generator_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, true, Build_CP );
		SetAvailableMapGoals( TEAM.ALLIES, true, Plant_CP );
		SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "SNIPE_.*" );
		
		SetAvailableMapGoals( TEAM.AXIS, false, "CHECKPOINT_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_axis_defend_keycardcapture_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_axis_defend_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_axis_defend_safe_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "CALLARTILLERY_axis_arti_.*" );
		
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_axis_defend_longway_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_axis_defend_generator_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_Storage_Barrier" );
		SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_Backyard_Barrier" );
		SetAvailableMapGoals( TEAM.AXIS, true, "MOUNTMG42_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "REPAIRMG42_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "CALLARTILLERY_axis_arti_longway_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "AIRSTRIKE_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "PLANTMINE_.*" );
		
		Util.EnableGoal("BUILD_House_MG42");
		Util.EnableGoal("BUILD_Backyard_Barrier");
		Util.EnableGoal("BUILD_Storage_Barrier");
	},
	
	Neutral_Command_Post_Built = function( trigger )
