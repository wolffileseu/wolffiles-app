APP_NAME=Wolffiles
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Luxembourg
APP_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database


SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# Hetzner S3 Object Storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_DEFAULT_REGION=eu-central
S3_BUCKET=
S3_ENDPOINT=
S3_URL=
S3_USE_PATH_STYLE_ENDPOINT=true

# For public file access (screenshots, thumbnails)
S3_PUBLIC_BUCKET=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="${APP_NAME}"

# Discord OAuth (optional)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=${APP_URL}/auth/discord/callback
DISCORD_REDIRECT_URI=
DISCORD_WEBHOOK_URL=




# MeiliSearch (optional, for advanced search)
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# ClamAV (optional, for virus scanning)
CLAMAV_SOCKET=/var/run/clamav/clamd.sock
CLAMAV_ENABLED=false

# Max upload size in MB
MAX_UPLOAD_SIZE=500

# Supported locales
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_AVAILABLE_LOCALES=en,de

VITE_APP_NAME="${APP_NAME}"

# Pterodactyl Panel
PTERODACTYL_URL=
PTERODACTYL_API_KEY=
PTERODACTYL_CLIENT_KEY=
PTERODACTYL_NODE_ID=

# Discord Hosting Notifications (bot-log channel webhook)
DISCORD_HOSTING_WEBHOOK_URL=

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
TELEGRAM_EVENTS=file_uploaded,file_approved,comment_posted,donation,user_registered,contact_form,server_order,news_posted,map_of_week,report
TELEGRAM_WEBHOOK_SECRET=


GITHUB_TOKEN=
GITHUB_REPO=
MISTRAL_API_KEY=
QDRANT_URL=http://localhost:6333

ANTHROPIC_API_KEY=


