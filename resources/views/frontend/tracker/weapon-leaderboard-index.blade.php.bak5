    {{-- Weapon Grid, grouped by category --}}
    @foreach($groups as $categoryKey => $weapons)
        @php
            $categoryHasData = collect($weapons)->contains(fn($_, $bit) => isset($totals[$bit]) && $totals[$bit]->global_kills > 0);
        @endphp
        @if($categoryHasData)
        <section class="mb-10">
            <h2 class="text-sm uppercase tracking-[0.3em] text-gray-500 mb-4 flex items-center gap-3">
                <span class="h-px bg-gradient-to-r from-amber-500/40 to-transparent flex-1"></span>
                <span>{{ \App\Services\Tracker\WeaponRegistry::categoryLabel($categoryKey) }}</span>
                <span class="h-px bg-gradient-to-l from-amber-500/40 to-transparent flex-1"></span>
            </h2>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                @foreach($weapons as $bit => $weapon)
                    @php $stat = $totals[$bit] ?? null; @endphp
                    <a href="{{ route('tracker.weapons.show', $weapon['slug']) }}"
                       class="group relative block rounded-lg bg-gray-800 hover:bg-gray-750 transition overflow-hidden">

                        {{-- Side indicator: tiny colored dot --}}
                        @if($weapon['side'] !== 'both')
                        <div class="absolute top-2 right-2 w-1.5 h-1.5 rounded-full
                                    {{ $weapon['side'] === 'axis' ? 'bg-red-500/70' : 'bg-blue-500/70' }}"></div>
                        @endif

                        <div class="p-4">
                            <div class="flex items-center justify-center h-10 mb-3">
                                <img src="{{ asset('img/tracker/weapons/'.$weapon['icon']) }}"
                                     alt="{{ $weapon['name'] }}"
                                     class="object-contain opacity-60 group-hover:opacity-100 transition group-hover:drop-shadow-[0_0_8px_rgba(245,158,11,0.6)]"
                                     style="max-height: 16px; filter: brightness(0.85) sepia(0.8) hue-rotate(355deg) saturate(2);">
                            </div>
                            <div class="text-white font-semibold text-sm truncate">{{ $weapon['name'] }}</div>
                            @if($stat && $stat->global_kills > 0)
                                <div class="mt-2 text-xs text-gray-500 space-y-0.5">
                                    <div><span class="text-amber-500 font-mono">{{ number_format($stat->global_kills) }}</span> kills</div>
                                    <div>{{ $stat->active_players }} {{ \Illuminate\Support\Str::plural('player', $stat->active_players) }}</div>
                                </div>
                            @else
                                <div class="mt-2 text-xs text-gray-600 italic">No data yet</div>
                            @endif
                        </div>
                    </a>
                @endforeach
            </div>
        </section>
        @endif
    @endforeach

