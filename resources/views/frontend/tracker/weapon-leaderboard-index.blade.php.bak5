                            <div>
                                <div class="text-3xl font-bold text-emerald-400" x-text="k.accuracy + '%'"></div>
                                <div class="text-xs uppercase tracking-wider text-gray-500">Accuracy</div>
                            </div>
                        </div>
                        <a :href="'/tracker/weapons/' + k.weapon_slug" class="inline-flex items-center gap-1 mt-5 text-xs text-amber-500/70 hover:text-amber-400 transition">
                            View full leaderboard →
                        </a>
                    </div>
                </div>
            </template>
            </div>

            {{-- Pagination dots --}}
            <div class="flex justify-center gap-1.5 mt-8">
                <template x-for="(k, i) in kings" :key="k.bit">
                    <button @click="idx = i"
                            :class="idx === i ? 'bg-amber-500 w-6' : 'bg-gray-700 w-1.5'"
