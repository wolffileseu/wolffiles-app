    {{-- Wall of Fame: rotating hero band --}}
    @if(count($kings) > 0)
    <div
        x-data="{
            kings: {{ \Illuminate\Support\Js::from(collect($kings)->map(fn($k,$bit)=>[
                'bit' => $bit,
                'weapon_name' => \App\Services\Tracker\WeaponRegistry::name((int)$bit),
                'weapon_slug' => \App\Services\Tracker\WeaponRegistry::slug((int)$bit),
                'icon' => \App\Services\Tracker\WeaponRegistry::iconUrl((int)$bit),
                'player_id' => $k->player_id,
                'player_name_html' => $k->name_html ?: e($k->name_clean),
                'kills' => $k->total_kills,
                'headshots' => $k->total_headshots,
                'accuracy' => round($k->accuracy_bp / 100, 1),
            ])->values()->all()) }},
            idx: 0,
            start() {
                setInterval(() => { this.idx = (this.idx + 1) % this.kings.length; }, 4500);
            }
        }"
        x-init="start()"
        class="relative overflow-hidden rounded-lg bg-gray-800 mb-10"
    >
        {{-- Diagonal accent stripes --}}
        <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[repeating-linear-gradient(45deg,transparent,transparent_20px,#f59e0b_20px,#f59e0b_21px)]"></div>

        <div class="relative px-8 py-10 md:px-14 md:py-14">
